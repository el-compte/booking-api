# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/booking-api
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_TTL_SECONDS=3600
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=*
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
# Optional: share rate limits between several instances
# REDIS_URL=redis://localhost:6379
# How often the webhook worker looks for due deliveries
WEBHOOK_WORKER_INTERVAL_MS=5000
# Allow webhook URLs on localhost/private networks (defaults to true outside production)
# WEBHOOK_ALLOW_PRIVATE_URLS=false
